<?xml version="1.0" encoding="utf-8"?>
<!-- Top Shelf Liquid Glass iOS: Chiều sâu kính đại dương có ánh sáng vát chéo -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nền kính lỏng sắc độ sâu -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="135"
                android:startColor="#20283E"
                android:centerColor="#101424"
                android:endColor="#080912"
                android:type="linear" />
        </shape>
    </item>
    <!-- Vệt cắt phản quang bề mặt kính lỏng -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="#30FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#48FFFFFF" />
        </shape>
    </item>
</layer-list>
