<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sky: blue-hour cinematic gradient instead of near-black gray -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#397FB0"
                android:centerColor="#173D5D"
                android:endColor="#081725"
                android:type="linear" />
        </shape>
    </item>
    <!-- Distant mountain ridge -->
    <item
        android:gravity="bottom"
        android:height="230dp">
        <shape android:shape="oval">
            <solid android:color="#183B49" />
        </shape>
    </item>
    <!-- Foreground landscape silhouette -->
    <item
        android:gravity="bottom"
        android:height="150dp">
        <shape android:shape="oval">
            <solid android:color="#0B282B" />
        </shape>
    </item>
</layer-list>
