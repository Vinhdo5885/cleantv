<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Blue-hour sky inspired by cinematic Apple TV landscapes -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#78B8E5" android:centerColor="#2E6C96" android:endColor="#10243A" android:type="linear" />
        </shape>
    </item>
    <!-- Distant rolling hills -->
    <item android:gravity="bottom" android:height="245dp">
        <shape android:shape="oval">
            <solid android:color="#244C61" />
        </shape>
    </item>
    <!-- Midground ridge -->
    <item android:gravity="bottom" android:height="185dp">
        <shape android:shape="oval">
            <solid android:color="#183F4C" />
        </shape>
    </item>
    <!-- Foreground landscape -->
    <item android:gravity="bottom" android:height="115dp">
        <shape android:shape="oval">
            <solid android:color="#0B2935" />
        </shape>
    </item>
    <!-- Darken lower screen slightly so icons and labels remain legible -->
    <item android:gravity="bottom" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#00000000" android:endColor="#88051320" android:type="linear" />
        </shape>
    </item>
</layer-list>