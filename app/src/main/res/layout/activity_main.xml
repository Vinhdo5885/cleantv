<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_wallpaper"
    android:orientation="vertical"
    android:paddingLeft="40dp"
    android:paddingTop="22dp"
    android:paddingRight="40dp"
    android:paddingBottom="18dp">

    <!-- ======================================================== -->
    <!-- PHẦN 1: MÀN HÌNH CHÀO VÀ TOP SHELF (LIQUID GLASS APPLE)   -->
    <!-- "Xin chào, Vinhdh" - Tối giản, sang trọng, không rối mắt -->
    <!-- ======================================================== -->
    <RelativeLayout
        android:id="@+id/layout_top_shelf"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/bg_top_shelf"
        android:paddingLeft="24dp"
        android:paddingTop="18dp"
        android:paddingRight="24dp"
        android:paddingBottom="18dp">

        <!-- Lời chào "Xin chào, Vinhdh" và biểu tượng App (Trái) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/shelf_app_icon"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_launcher" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:orientation="vertical">

                <!-- Lời chào chính cá nhân hóa -->
                <TextView
                    android:id="@+id/tv_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xin chào, Vinhdh"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- Dòng trạng thái ngữ cảnh -->
                <TextView
                    android:id="@+id/shelf_app_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Hôm nay bạn muốn xem gì?"
                    android:textColor="#9CA3AF"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Đồng hồ số lớn & Ngày tháng (Phải) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:gravity="right"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/text_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFF"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#9CA3AF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_settings"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/selector_card"
                android:focusable="true"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="⚙ Cài đặt"
                android:textColor="#D1D5DB"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- ======================================================== -->
    <!-- PHẦN 2: DOCK KÍNH LỎNG (LIQUID GLASS) VÀ DANH SÁCH ỨNG DỤNG -->
    <!-- ======================================================== -->
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tiêu đề Dock Yêu thích -->
            <TextView
                android:id="@+id/tv_title_favorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.06"
                android:text="YÊU THÍCH"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Khung Dock Kính Lỏng (Liquid Glass) bo cong chuẩn iOS -->
            <HorizontalScrollView
                android:id="@+id/scroll_dock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_dock"
                android:clipToPadding="false"
                android:paddingLeft="16dp"
                android:paddingTop="12dp"
                android:paddingRight="16dp"
                android:paddingBottom="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_dock_apps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Tiêu đề Tất cả ứng dụng -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:letterSpacing="0.06"
                android:text="ỨNG DỤNG"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Lưới ứng dụng -->
            <com.cleantv.launcher.view.TvGridView
                android:id="@+id/grid_all_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:horizontalSpacing="16dp"
                android:numColumns="5"
                android:stretchMode="columnWidth"
                android:verticalSpacing="16dp" />

            <TextView
                android:id="@+id/tv_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="30dp"
                android:text="Đang tải ứng dụng..."
                android:textColor="#9CA3AF"
                android:textSize="16sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="40dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
