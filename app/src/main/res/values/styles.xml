<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Giao diện toàn màn hình, không thanh điều hướng cho Android TV -->
    <style name="Theme.CleanTV" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@drawable/bg_wallpaper</item>
        <item name="android:colorBackground">@color/bg_dark_gradient_end</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Nút bàn phím số điều khiển từ xa -->
    <style name="NumPadButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/selector_card</item>
        <item name="android:focusable">true</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="NumPadButtonAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/selector_dialog_item</item>
        <item name="android:focusable">true</item>
        <item name="android:textColor">#60A5FA</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
